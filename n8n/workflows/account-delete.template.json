      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [180, 400]
    },
    {
      "parameters": {
        "jsCode": "// Extract + validate userId, and pre-build the Appwrite Query.equal(\"user_id\", userId)\n// string used by every List Rows call below (Appwrite TablesDB REST query format).\nconst body = $json.body || $json;\nconst userId = body.userId;\nif (!userId) {\n  throw new Error('account-delete: missing userId');\n}\nconst queryUserId = JSON.stringify({ method: 'equal', attribute: 'user_id', values: [userId] });\nreturn [{ json: { userId, queryUserId } }];"
      },
      "id": "validate-extract",
      "name": "Validate & Extract userId",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 400]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.APPWRITE_ENDPOINT }}/databases/piggnify_mobile_db/tables/subscriptions/rows",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "queries[]", "value": "={{ $json.queryUserId }}" }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Appwrite-Project", "value": "={{ $env.APPWRITE_PROJECT_ID }}" },
            { "name": "X-Appwrite-Key", "value": "={{ $env.APPWRITE_API_KEY }}" }
          ]
        },
        "options": { "response": { "response": { "neverError": false } } }
      },
      "id": "list-subscription-row",
      "name": "Appwrite: List Subscription Row",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 300]
    },
    {
      "parameters": {
        "jsCode": "// Decide whether a live Stripe subscription needs canceling before we purge rows.\n// Mirrors n8n/code-nodes/account-deletion.js buildDeletionPlan().\nconst userId = $('Validate & Extract userId').item.json.userId;\nconst rows = $json.rows || [];\nconst subscriptionRow = rows[0] || null;\n\nconst stripeSubscriptionId = subscriptionRow ? subscriptionRow.stripe_subscription_id : null;\nconst cancelableStatuses = ['trialing', 'active', 'past_due', 'cancel_scheduled'];\nconst needsStripeCancel =\n  !!stripeSubscriptionId && cancelableStatuses.includes(subscriptionRow.status);\n\nreturn [{\n  json: {\n    userId,\n    needsStripeCancel,\n    stripeSubscriptionId: needsStripeCancel ? stripeSubscriptionId : null,\n  },\n}];"
      },
      "id": "build-deletion-plan",
      "name": "Build Deletion Plan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.needsStripeCancel }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "needs-stripe-cancel",
      "name": "Needs Stripe Cancel?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1140, 300]
    },
    {
      "parameters": {
        "method": "DELETE",
        "url": "=https://api.stripe.com/v1/subscriptions/{{ $json.stripeSubscriptionId }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "stripeApi",
        "options": { "response": { "response": { "neverError": true } } }
      },
      "id": "stripe-cancel-subscription",
      "name": "Stripe Cancel Subscription",
      "type": "n8n-nodes-base.httpRequest",
